---
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { agentNote, siteUrl, twinPath } from '../../lib/markdown-twin.mjs';
import MarkdownMenu from './MarkdownMenu.svelte';

// Only docs pages carry the note and the menu; the 404 page renders through this component too.
const { id } = Astro.locals.starlightRoute.entry;
const isDocsPage = id.startsWith('docs/');
const site = siteUrl(import.meta.env.BASE_URL);
---

{isDocsPage ? (
  <div class="title-row">
    <Default>
      <slot />
    </Default>
    <MarkdownMenu client:load twin={new URL(twinPath(id), site).href} llms={`${site}llms.txt`} />
  </div>
) : (
  <Default>
    <slot />
  </Default>
)}
{isDocsPage && (
  <p class="sr-only" aria-hidden="true" data-agent-note>
    {agentNote(site)}
  </p>
)}

<style>
  .title-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }
  /* Starlight's top margin on the h1 moves to the row, so the button centres on the title. */
  .title-row :global(h1) {
    margin-top: 0;
  }
</style>
