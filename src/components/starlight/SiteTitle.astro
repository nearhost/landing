---
import Mark from '../Mark.astro';
---

<div class="title">
  <a href="/" class="brand" aria-label="Nearhost home">
    <Mark size={26} />
    <span class="word">nearhost</span>
  </a>
  <span class="sep" aria-hidden="true">
    /
  </span>
  <a href="/docs/getting-started/introduction/" class="docs">
    Docs
  </a>
</div>

<style>
  .title {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--sl-color-white);
    text-decoration: none;
  }
  .word {
    font-family: var(--nh-font-display);
    font-weight: 600;
    font-size: 20px;
    letter-spacing: -0.02em;
  }
  .sep {
    color: var(--sl-color-gray-4);
  }
  .docs {
    font-size: 15px;
    font-weight: 500;
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }
</style>
