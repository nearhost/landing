---
interface Props {
  size?: number;
  title?: string;
}
const { size = 28, title } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 64 64"
  role={title ? 'img' : undefined}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}
  class="mark"
>
  <path
    d="M13 17l15 15-15 15"
    fill="none"
    stroke="var(--nh-mark-chevron)"
    stroke-width="8"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>
  <circle cx="46" cy="44" r="7.5" fill="var(--nh-mark-dot)"></circle>
</svg>

<style>
  .mark {
    display: block;
    flex: none;
  }
</style>
