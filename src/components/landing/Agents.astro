---
// The agent gallery. To add a scene:
//   1. add its entry to `scenes` in ./agents/scenes.ts (the order there is the tour's order);
//   2. write its component in ./agents/, built from Scene, Terminal and NearhostWindow and marked
//      with the step classes described in ./agents/scenes.ts;
//   3. add one line for it to `components` below.
// Nothing else here changes: the selectors, panels, styles and script read `scenes`.
import { url } from '../../lib/url';
import CopyButton from '../CopyButton.svelte';
import ClaudeScene from './agents/ClaudeScene.astro';
import CodexScene from './agents/CodexScene.astro';
import { scenes, type Scene } from './agents/scenes';

const install = 'npx skills add nearhost/nearhost -g';
const first = scenes[0];
const components: Partial<Record<Scene['id'], typeof ClaudeScene>> = {
  claude: ClaudeScene,
  codex: CodexScene,
};
// What the script needs to play the tour; the copy itself is rendered below.
const tour = JSON.stringify(
  scenes.map(({ id, caption, link, prompt, perChar }) => ({ id, caption, link, prompt, perChar })),
);
---

<section id="agents" class="agents">
  <div class="container inner">
    <div class="intro">
      <h2>Your agent asks. You say yes.</h2>
      <p>
        Coding agents on a server can add the project to Nearhost, open the preview they just
        started, and show you the plan they wrote, in the browser on your laptop. Nearhost asks you
        first, every time, and the agent gets the address once you say yes.
      </p>
      <a class="more" href={url('/docs/getting-started/use-a-coding-agent/')}>
        Use a coding agent
      </a>
    </div>

    <!-- The selectors name what the agent asks for, never the agent: a name there would suggest
         the feature works only in that one. -->
    <div class="tabs" role="tablist" aria-label="What an agent can ask for" hidden>
      {scenes.map((scene, i) => (
        <button
          type="button"
          role="tab"
          class="tab"
          id={`agents-tab-${scene.id}`}
          aria-controls={`agents-${scene.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
        >
          <span class="edge" aria-hidden="true">
            <span class="fill" />
          </span>
          <span class="title">{scene.title}</span>
          <span class="tag">{scene.tag}</span>
        </button>
      ))}
    </div>

    <!-- Scripted transcripts, kept out of search snippets and AI answers. Without the script
         every scene shows finished, one under another. -->
    <div
      class="stage"
      data-agents
      data-nosnippet
      data-scene={first.id}
      data-step="4"
      data-tour={tour}
    >
      {scenes.map(({ id }) => {
        const Component = components[id]!;
        return (
          <div
            role="tabpanel"
            id={`agents-${id}`}
            data-panel={id}
            aria-labelledby={`agents-tab-${id}`}
          >
            <Component />
          </div>
        );
      })}
    </div>

    <div class="below">
      <div class="caption" data-caption-block hidden>
        <p data-caption>{first.caption}</p>
        <a class="more" data-link href={first.link.href}>
          {first.link.text}
        </a>
      </div>
      <div class="controls" data-controls hidden>
        <button type="button" class="control" data-toggle aria-label="Play the tour">
          <svg
            class="i-pause"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <rect x="6" y="5" width="4" height="14" rx="1"></rect>
            <rect x="14" y="5" width="4" height="14" rx="1"></rect>
          </svg>
          <svg
            class="i-play"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z"></path>
          </svg>
        </button>
        <button type="button" class="control" data-prev aria-label="Previous">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M15 18l-6-6 6-6"></path>
          </svg>
        </button>
        <span class="pos">
          <span data-pos>1</span> of {scenes.length}
        </span>
        <button type="button" class="control" data-next aria-label="Next">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M9 18l6-6-6-6"></path>
          </svg>
        </button>
      </div>
    </div>

    <div class="after">
      <ul class="facts">
        <li>Nothing is added, forwarded or opened until you say yes in Nearhost.</li>
        <li>
          On a server, the agent reaches Nearhost through the SSH connection Nearhost already has.
          No port is opened on the server.
        </li>
        <li>
          Works in Claude Code, Codex, Qwen Code, Cursor, Gemini CLI and any agent that reads
          skills.
        </li>
      </ul>
      <div class="get">
        <span class="label">Give your agent the skill</span>
        <div class="line">
          <code id="install-skill">{install}</code>
          <CopyButton
            client:visible
            text={install}
            label="Copy the skill install command"
            targetId="install-skill"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Plays the gallery once the stage is in view: each scene types its prompt, steps through the
  // exchange, pauses on the finished frame and hands over to the next. Clicking a selector or an
  // arrow, or moving focus into the section, stops it on that scene, finished. With reduced motion
  // it waits for play.
  import { createTour } from '../../lib/agent-tour.mjs';

  interface TourScene {
    id: string;
    caption: string;
    link: { text: string; href: string };
    prompt: string;
    perChar: number;
  }

  for (const stage of document.querySelectorAll<HTMLElement>('[data-agents]')) {
    const section = stage.closest('section')!;
    const scenes: TourScene[] = JSON.parse(stage.dataset.tour ?? '[]');
    const tablist = section.querySelector<HTMLElement>('[role="tablist"]')!;
    const tabs = [...tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const caption = section.querySelector<HTMLElement>('[data-caption]')!;
    const link = section.querySelector<HTMLAnchorElement>('[data-link]')!;
    const pos = section.querySelector<HTMLElement>('[data-pos]')!;
    const panels = [...stage.querySelectorAll<HTMLElement>('[data-panel]')];
    // Hidden until the script runs: without it, every scene shows finished and nothing to pick.
    const chrome = [
      tablist,
      ...section.querySelectorAll<HTMLElement>('[data-controls], [data-caption-block]'),
    ];
    // The panels share one grid cell, so the stage keeps the tallest one's height; the others
    // stay laid out but invisible and out of reach.
    const showPanel = (id: string) =>
      panels.forEach((p) => {
        const off = p.dataset.panel !== id;
        p.inert = off;
        if (off) p.setAttribute('aria-hidden', 'true');
        else p.removeAttribute('aria-hidden');
      });
    const toggle = section.querySelector<HTMLButtonElement>('[data-toggle]')!;
    let current = 0;
    let isPlaying = false;

    const tour = createTour({
      scenes,
      render({ scene, step, typed, playing, runMs }) {
        const { id } = scenes[scene];
        current = scene;
        stage.dataset.scene = id;
        showPanel(id);
        stage.dataset.step = String(step);
        stage.classList.toggle('playing', playing);
        isPlaying = playing;
        const box = stage.querySelector<HTMLElement>(`[data-panel="${id}"] [data-typed]`);
        if (box) box.textContent = typed;
        caption.textContent = scenes[scene].caption;
        link.href = scenes[scene].link.href;
        link.textContent = scenes[scene].link.text;
        pos.textContent = String(scene + 1);
        toggle.toggleAttribute('data-playing', playing);
        toggle.setAttribute('aria-label', playing ? 'Pause the tour' : 'Play the tour');
        tabs.forEach((tab, i) => {
          const selected = i === scene;
          tab.setAttribute('aria-selected', String(selected));
          tab.tabIndex = selected ? 0 : -1;
          // The selected edge fills over the scene's run, from the first typed character.
          const full = selected && (!playing || step > 0 || typed !== '');
          const fill = tab.querySelector<HTMLElement>('.fill')!;
          fill.style.transitionDuration = full && playing ? `${Math.max(runMs - 600, 0)}ms` : '0s';
          fill.style.width = full ? '100%' : '0%';
        });
      },
    });

    // The tour starts once enough of the stage is in view: half of it, or half the viewport when
    // the stage is taller than that. While it is out of view or the page is hidden the tour is
    // suspended, and it restarts the scene it was on when it comes back.
    let started = false;
    let chosen = false;
    let suspended = false;
    let inView = false;
    const update = () => {
      if (chosen) return;
      if (inView && !document.hidden) {
        if (!started) {
          started = true;
          tour.start({ still: window.matchMedia('(prefers-reduced-motion: reduce)').matches });
        } else if (suspended) {
          suspended = false;
          tour.play(current);
        }
      } else if (isPlaying) {
        suspended = true;
        tour.destroy();
      }
    };
    const seen = new IntersectionObserver(
      ([entry]) => {
        const viewport = entry.rootBounds?.height ?? window.innerHeight;
        const needed = Math.min(entry.boundingClientRect.height, viewport) * 0.5;
        inView = entry.isIntersecting && entry.intersectionRect.height >= needed - 1;
        update();
      },
      { threshold: Array.from({ length: 101 }, (_, i) => i / 100) },
    );
    document.addEventListener('visibilitychange', update);
    // Any choice the reader makes stands: the tour no longer starts, stops or restarts by itself.
    const choose = (fn: () => void) => {
      started = true;
      chosen = true;
      suspended = false;
      seen.disconnect();
      document.removeEventListener('visibilitychange', update);
      fn();
    };
    // Focus moving into the section stops the tour on the current scene, finished, so keyboard
    // and screen reader users are never moved on. A press is left to its click handler, which
    // runs after the focus it causes (after the touch ends, on a touch screen).
    let pressed = false;
    section.addEventListener('pointerdown', () => (pressed = true));
    for (const type of ['click', 'pointercancel']) {
      window.addEventListener(type, () => (pressed = false));
    }
    section.addEventListener('focusin', () => {
      if (!chosen && !pressed) choose(() => tour.show(current));
    });

    tabs.forEach((tab, i) => tab.addEventListener('click', () => choose(() => tour.show(i))));
    tablist.addEventListener('keydown', (event) => {
      const at = tabs.indexOf(document.activeElement as HTMLButtonElement);
      if (at < 0) return;
      const to = {
        ArrowLeft: at - 1,
        ArrowRight: at + 1,
        Home: 0,
        End: tabs.length - 1,
      }[event.key];
      if (to === undefined) return;
      event.preventDefault();
      const i = (to + tabs.length) % tabs.length;
      tabs[i].focus();
      choose(() => tour.show(i));
    });
    toggle.addEventListener('click', () => choose(() => tour.toggle()));
    section
      .querySelector('[data-prev]')!
      .addEventListener('click', () => choose(() => tour.show(current - 1)));
    section
      .querySelector('[data-next]')!
      .addEventListener('click', () => choose(() => tour.show(current + 1)));

    stage.classList.add('live');
    showPanel(stage.dataset.scene ?? scenes[0].id);
    chrome.forEach((el) => (el.hidden = false));
    seen.observe(stage);
  }
</script>

<style>
  .more {
    align-self: flex-start;
    color: var(--nh-accent);
    font-size: 15px;
    font-weight: 500;
  }
  .more:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .agents {
    border-top: 1px solid var(--nh-line);
  }
  .inner {
    padding-block: 112px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .intro {
    display: flex;
    flex-direction: column;
    gap: 28px;
    max-width: 760px;
  }
  .intro h2 {
    margin: 0;
    font-family: var(--nh-font-display);
    font-weight: 700;
    font-size: clamp(40px, 6vw, 80px);
    line-height: 1;
    letter-spacing: var(--nh-track-display);
    text-wrap: balance;
  }
  .intro p {
    margin: 0;
    color: var(--nh-body);
    font-size: 18px;
  }

  /* The selectors, one column per scene: a title, what it is, and a top edge that fills as the
     scene plays. */
  .tabs {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 12px;
  }
  .tab {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-height: 44px;
    padding: 16px 18px 18px;
    text-align: left;
    background: transparent;
    border: 1px solid var(--nh-line);
    border-radius: var(--nh-radius-m);
    color: var(--nh-muted);
    font-family: var(--nh-font-body);
    cursor: pointer;
  }
  .tab[aria-selected='true'] {
    background: var(--nh-surface);
    color: var(--nh-text);
  }
  .edge {
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: var(--nh-line);
  }
  .fill {
    display: block;
    width: 0;
    height: 100%;
    background: var(--nh-accent);
    transition-property: width;
    transition-timing-function: linear;
  }
  .tab[aria-selected='true'] .fill {
    width: 100%;
  }
  .title {
    font-family: var(--nh-font-display);
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .tag {
    font-size: 14px;
    color: var(--nh-faint);
  }
  .tab[aria-selected='true'] .tag {
    color: var(--nh-accent);
  }

  /* One panel per scene. Without the script they stack; with it they share one cell, so the
     stage keeps the tallest panel's height, and only the current one is visible. */
  .stage {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .stage.live {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  .stage.live > [data-panel] {
    grid-area: 1 / 1;
    min-width: 0;
  }
  .stage.live > [data-panel][inert] {
    visibility: hidden;
  }

  /* Each part of the exchange waits for its step. Without the script the step is 4: finished. */
  .stage[data-step='0'] :global(.from-1),
  .stage:is([data-step='0'], [data-step='1']) :global(.from-2),
  .stage:not([data-step='4']) :global(.from-4),
  .stage:not([data-step='1']) :global(.at-1),
  .stage:not([data-step='2'], [data-step='3']) :global(.at-2-3),
  .stage:is([data-step='0'], [data-step='4']) :global(.busy) {
    display: none;
  }
  .stage :global(:is(.prompt, .browser)) {
    transition: opacity 0.3s;
  }
  .stage:is([data-step='0'], [data-step='1']) :global(.prompt) {
    opacity: 0;
  }
  .stage[data-step='4'] :global(.prompt) {
    opacity: 0.45;
  }
  .stage:not([data-step='4']) :global(.browser) {
    opacity: 0;
  }
  .stage[data-step='2'] :global(.badge) {
    display: inline-block;
  }
  .stage :global(.key) {
    color: #d6f26b;
    border-radius: 3px;
  }
  .stage[data-step='3'] :global(.key) {
    background: #d6f26b;
    color: #0f1210;
  }

  /* The caption for the current scene, and the tour's controls. */
  .below {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
    flex-wrap: wrap;
    padding-top: 8px;
  }
  .caption {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: 680px;
    flex: 1 1 420px;
    min-width: 0;
  }
  .caption p {
    margin: 0;
    color: var(--nh-body);
    font-size: 16px;
  }
  .controls {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .tabs[hidden],
  .caption[hidden],
  .controls[hidden] {
    display: none;
  }
  .control {
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: 1px solid var(--nh-line);
    border-radius: var(--nh-radius-m);
    color: var(--nh-text);
    cursor: pointer;
  }
  .control:hover {
    background: var(--nh-surface);
  }
  [data-toggle]:not([data-playing]) .i-pause,
  [data-toggle][data-playing] .i-play {
    display: none;
  }
  .pos {
    min-width: 52px;
    text-align: center;
    font-family: var(--nh-font-mono);
    font-size: 13px;
    color: var(--nh-faint);
  }

  .after {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 32px 56px;
    align-items: end;
  }
  .facts {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    color: var(--nh-body);
  }
  .facts li {
    padding-left: 18px;
    position: relative;
  }
  .facts li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--nh-accent);
  }
  .get {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px 12px 16px 22px;
    background: var(--nh-surface);
    border: 1px solid var(--nh-line);
    border-radius: 12px;
    min-width: 0;
  }
  .label {
    font-size: 13px;
    color: var(--nh-faint);
  }
  .line {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .line code {
    font-size: 14px;
    white-space: nowrap;
    overflow-x: auto;
    flex: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .stage :global(:is(.prompt, .browser)),
    .fill {
      transition: none !important;
    }
  }
  @media (max-width: 900px) {
    .tabs {
      grid-auto-flow: row;
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 719px) {
    .inner {
      padding-block: 80px;
    }
    .after {
      grid-template-columns: 1fr;
    }
  }
</style>
