---
---

<section class="container wrap" aria-label="Nearhost terminal interface">
  <div class="window">
    <div class="titlebar">
      <span>nearhost</span>
      <span>proxy :443 ● · CA trusted · hosts ok</span>
    </div>
    <div class="panes">
      <div class="sidebar">
        <div class="side-head">servers</div>

        <div class="row group">
          <span>▾ local</span>
        </div>
        <div class="row child">
          <span>
            <span class="running">●</span> website
          </span>
          <span class="faint">running</span>
        </div>
        <div class="row child muted">
          <span>
            <span class="off">○</span> ipbar
          </span>
          <span class="faint">stopped</span>
        </div>

        <div class="row group gap">
          <span>▾ mini</span>
          <span class="running">● connected</span>
        </div>
        <div class="row selected">
          <span>
            <span class="running">●</span> myapp
          </span>
          <span class="muted">running</span>
        </div>
        <div class="row child">
          <span>
            <span class="starting">◐</span> otherapp
          </span>
          <span class="faint">starting</span>
        </div>

        <div class="row group gap">
          <span>▾ vps</span>
          <span class="failed">○ auth failed</span>
        </div>
        <div class="row child muted">
          <span>
            <span class="off">○</span> clientsite
          </span>
          <span class="faint">stopped</span>
        </div>

        <div class="side-foot">n new · m menu · q quit</div>
      </div>

      <div class="panel">
        <div class="panel-head">
          <div class="panel-title">
            <span class="name">myapp</span>
            <span class="accent">https://myapp.test</span>
          </div>
          <div class="hint">o open · e edit · d remove</div>
        </div>
        <div class="meta">
          <span>
            <span class="faint">server</span> mini
          </span>
          <span>
            <span class="faint">path</span> ~/Code/myapp
          </span>
          <span>
            <span class="faint">state</span> <span class="running">running</span>
          </span>
        </div>

        <div class="scroll">
          <div class="routes">
            <div class="th">port</div>
            <div class="th">role</div>
            <div class="th">label</div>
            <div class="th">local</div>
            <div class="th">status</div>

            <div>80</div>
            <div class="accent">web</div>
            <div>Laravel (APP_PORT)</div>
            <div>52114</div>
            <div class="running">●</div>
            <div>5174</div>
            <div class="muted">loopback</div>
            <div>Vite (VITE_PORT)</div>
            <div>5174</div>
            <div class="running">●</div>
            <div class="faint">3306</div>
            <div class="faint">ignore</div>
            <div class="faint">MySQL (FORWARD_DB_PORT)</div>
            <div class="faint">–</div>
            <div class="faint">–</div>
          </div>
        </div>

        <div class="advisory">
          <span>▲</span>
          <span>
            APP_URL mismatch: set <span class="text">APP_URL=https://myapp.test</span> in .env{' '}
            <span class="faint">· y copy</span>
          </span>
        </div>

        <!-- prettier-ignore -->
        <div class="log">
          <div class="log-head">log</div>
          <div><span class="time">12:04:01</span>  forward  127.0.0.1:52114 → mini:80</div>
          <div><span class="time">12:04:01</span>  forward  127.0.0.1:5174 → mini:5174</div>
          <div><span class="time">12:04:02</span>  proxy    <span class="running">https://myapp.test ready</span></div>
          <div><span class="time">12:04:09</span>  GET /                 200  41ms</div>
          <div><span class="time">12:04:09</span>  GET /@vite/client     200  3ms</div>
          <div><span class="time">12:04:10</span>  ws  /?token=…         upgraded</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .wrap {
    padding-bottom: 112px;
  }
  .window {
    background: color-mix(in srgb, var(--nh-ground) 85%, black);
    border: 1px solid var(--nh-line);
    border-radius: var(--nh-radius-l);
    overflow: hidden;
    box-shadow: 0 40px 120px rgba(0, 0, 0, 0.5);
  }
  .titlebar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 16px;
    border-bottom: 1px solid var(--nh-raised);
    font-family: var(--nh-font-mono);
    font-size: 12px;
    color: var(--nh-faint);
  }
  .panes {
    display: flex;
    flex-wrap: wrap;
    font-family: var(--nh-font-mono);
    font-size: 13.5px;
    line-height: 1.7;
  }
  .sidebar {
    flex: 1 1 240px;
    max-width: 300px;
    min-width: 0;
    border-right: 1px solid var(--nh-raised);
    padding: 18px 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .side-head {
    padding: 0 18px 8px;
    color: var(--nh-faint);
    font-size: 12px;
  }
  .side-foot {
    margin-top: auto;
    padding: 18px 18px 0;
    color: var(--nh-faint);
    font-size: 12px;
  }
  .row {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  .group {
    padding: 0 18px;
    color: var(--nh-text);
  }
  .gap {
    margin-top: 10px;
  }
  .child {
    padding: 0 18px 0 32px;
  }
  .selected {
    margin: 0 8px;
    padding: 2px 10px 2px 24px;
    background: var(--nh-surface);
    border-radius: var(--nh-radius-s);
    border-left: 2px solid var(--nh-accent);
  }
  .panel {
    flex: 999 1 560px;
    min-width: 0;
    padding: 18px 24px 22px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .panel-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .panel-title {
    display: flex;
    align-items: baseline;
    gap: 14px;
    flex-wrap: wrap;
  }
  .name {
    font-size: 18px;
    color: var(--nh-text);
    font-weight: 500;
  }
  .hint {
    color: var(--nh-faint);
    font-size: 12px;
  }
  .meta {
    display: flex;
    gap: 28px;
    flex-wrap: wrap;
    color: var(--nh-muted);
  }
  .scroll {
    overflow-x: auto;
  }
  .routes {
    display: grid;
    grid-template-columns: 70px 100px minmax(200px, 1fr) 80px 70px;
    column-gap: 12px;
    row-gap: 2px;
    min-width: 560px;
  }
  .th {
    color: var(--nh-faint);
    font-size: 12px;
  }
  .advisory {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    color: var(--nh-starting);
    background: color-mix(in srgb, var(--nh-starting) 7%, transparent);
    border: 1px solid color-mix(in srgb, var(--nh-starting) 25%, transparent);
    border-radius: var(--nh-radius-s);
    padding: 8px 12px;
    font-size: 13px;
  }
  .log {
    display: flex;
    flex-direction: column;
    color: var(--nh-muted);
    font-size: 13px;
    border-top: 1px solid var(--nh-raised);
    padding-top: 12px;
  }
  .log div {
    white-space: pre-wrap;
  }
  .log-head {
    color: var(--nh-faint);
    font-size: 12px;
    margin-bottom: 4px;
  }
  .time,
  .off {
    color: color-mix(in srgb, var(--nh-faint) 60%, var(--nh-ground));
  }
  .running {
    color: var(--nh-running);
  }
  .starting {
    color: var(--nh-starting);
  }
  .failed {
    color: var(--nh-failed);
  }
  .accent {
    color: var(--nh-accent);
  }
  .text {
    color: var(--nh-text);
  }
  .muted {
    color: var(--nh-muted);
  }
  .faint {
    color: var(--nh-faint);
  }
  @media (max-width: 719px) {
    .sidebar {
      max-width: none;
      border-right: 0;
      border-bottom: 1px solid var(--nh-raised);
    }
  }
</style>
