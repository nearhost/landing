---
import TuiDemo from './TuiDemo.svelte';
---

<section class="container wrap">
  <TuiDemo client:visible />
  <p class="caption">
    Every key works. No servers were harmed. Click in and press <kbd>?</kbd>
  </p>
</section>

<style>
  .wrap {
    padding-bottom: 112px;
  }
  .caption {
    margin: 16px 0 0;
    text-align: center;
    color: var(--nh-faint);
    font-size: 14px;
  }
  kbd {
    font-family: var(--nh-font-mono);
    color: var(--nh-accent);
  }
</style>
