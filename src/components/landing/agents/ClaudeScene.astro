---
// Scene 1: Claude Code on the server asks Nearhost to add the project, and the add form opens on
// the laptop. The step classes (from-1, at-1, …) are shown or hidden by the gallery's data-step.
import NearhostWindow from './NearhostWindow.astro';
import Scene from './Scene.astro';
import Terminal from './Terminal.astro';

// Claude Code's logo as it prints it: block characters in three rows, each
// cell split into quadrants (top left, top right, bottom left, bottom right).
// Drawn as an SVG, so the rows meet whatever the line height.
const quadrants: Record<string, number[]> = {
  ' ': [],
  '▐': [1, 3],
  '▛': [0, 1, 2],
  '█': [0, 1, 2, 3],
  '▝': [1],
  '▜': [0, 1, 3],
  '▀': [0, 1],
};
const logoRows = [' ▐▛███▛█ ', '▝▜██████▀', ' ▝▝   ▝▝ '];
const logo = logoRows.flatMap((row, y) =>
  [...row].flatMap((ch, x) =>
    quadrants[ch].map((q) => ({ x: x * 2 + (q % 2), y: y * 2 + Math.floor(q / 2) })),
  ),
);
---

<Scene>
  <Terminal slot="terminal" title="claude on mini">
    <!-- prettier-ignore -->
    <div class="cc">
      <div class="head">
        <svg class="logo" viewBox="0 0 18 6" preserveAspectRatio="none" shape-rendering="crispEdges" aria-hidden="true">{logo.map((p) => <rect x={p.x} y={p.y} width="1" height="1" />)}</svg>
        <div>
          <div class="r hl"><b>Claude Code</b> <span class="grey">v2.1.301</span></div>
          <div class="r hl grey">Opus 5.5 · Claude Max</div>
          <div class="r hl grey">~/code/myapp</div>
        </div>
      </div>
      <div class="r"></div>
      <div class="from-1">
        <div class="r you"><span class="grey">❯</span> <span class="white">/nearhost:nearhost add</span></div>
        <div class="r"></div>
      </div>
      <div class="at-1">
        <div class="r">  Proposing this project to Nearhost</div>
        <div class="r grey">  ⎿  $ sh ~/.claude/skills/nearhost/scripts/nearhost.sh propose .</div>
        <div class="r"></div>
        <div class="r"><span class="spin">✢ Combobulating…</span> <span class="grey">(2s · esc to interrupt)</span></div>
        <div class="r"></div>
      </div>
      <div class="from-2">
        <div class="r grey">  Ran <b>1</b> shell command</div>
        <div class="r"></div>
        <div class="w h2"><span class="white">⏺</span> I've proposed myapp to Nearhost. Review it in Nearhost on ecs@macbook.</div>
        <div class="r"></div>
      </div>
      <div class="at-2-3">
        <div class="r">  Waiting for your answer in Nearhost</div>
        <div class="r grey">  ⎿  $ sh ~/.claude/skills/nearhost/scripts/nearhost.sh wait 7c1f04a2e9b3d851</div>
        <div class="r"></div>
        <div class="r"><span class="spin">✻ Percolating…</span> <span class="grey">(14s · esc to interrupt)</span></div>
        <div class="r"></div>
      </div>
      <div class="from-4">
        <div class="r grey">  Ran <b>1</b> shell command</div>
        <div class="r"></div>
        <div class="w h2"><span class="white">⏺</span> Added. myapp is running at <span class="lav">https://myapp.test</span>, served from port 5173 on mini.</div>
        <div class="r"></div>
        <div class="r grey">✻ Brewed for 21s</div>
        <div class="r"></div>
      </div>
      <div class="hr"></div>
      <div class="r"><span class="grey">❯</span> <span class="lav" data-typed></span><span class="caret"></span></div>
      <div class="hr"></div>
      <div class="r grey">  ? for shortcuts</div>
    </div>
  </Terminal>
  <NearhostWindow slot="laptop">
    <!-- prettier-ignore -->
    <div class="nh">
      <div class="r status"><span><span class="accent">∩</span> nearhost</span><span class="dim">proxy <span class="ok">●</span></span></div>
      <div class="rule"></div>
      <div class="r"><b>Nearhost</b></div>
      <div class="r"><span class="dim">running  </span><span class="before-4">1</span><span class="from-4">2</span> of 2 projects</div>
      <div class="r added">Added myapp, as an agent on mini proposed.</div>
      <div class="prompt box">
        <div class="r spread"><span><b>Add project</b><span class="dim"> · routes</span></span><span class="dim">5 of 7</span></div>
        <div class="progress"><div></div></div>
        <div class="r amber">Proposed by an agent on mini</div>
        <div class="r"></div>
        <div class="r"><span class="dim">server  </span><span>mini</span></div>
        <div class="r"><span class="dim">path    </span><span>/home/dev/code/myapp</span></div>
        <div class="r"></div>
        <div class="r dim">    port  role      label</div>
        <div class="r sel"><span class="accent">▌</span>[x] 5173  <span class="accent">‹ web ›</span>   vite</div>
        <div class="r"> [ ] 5432  ignore    db</div>
        <div class="r"></div>
        <div class="r"><span class="key">enter</span><span class="dim"> next · esc back</span></div>
      </div>
    </div>
  </NearhostWindow>
</Scene>

<style>
  /* Claude Code's own colours, as its terminal session draws them. */
  .cc {
    padding: 2px 1ch 0;
  }
  .head {
    display: flex;
    gap: 3ch;
    align-items: center;
  }
  .logo {
    flex: none;
    width: 9ch;
    height: 3.9em;
    fill: #d77757;
  }
  .hl {
    min-height: 1.3em;
    line-height: 1.3em;
  }
  .grey {
    color: #999;
  }
  .white {
    color: #fff;
  }
  .lav {
    color: #b1b9f9;
  }
  .spin {
    color: #c75b4e;
  }
  .you {
    background: #373737;
    margin-inline: -2ch;
    padding-inline: 2ch;
  }
  .hr {
    margin-inline: -2ch;
    height: 1.5em;
    background: linear-gradient(#888, #888) 0 50% / 100% 1px no-repeat;
  }

  /* Nearhost, with the add form open: the agent's proposal. */
  .nh {
    padding: 10px 1ch 14px;
  }
  .status,
  .spread {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  .rule {
    height: 1px;
    margin: 2px 0 10px;
    background: #1e231f;
  }
  .accent {
    color: #d6f26b;
  }
  .dim {
    color: #7c8479;
  }
  .ok {
    color: #7fdb8a;
  }
  .amber {
    color: #f2b84b;
  }
  .box {
    margin-top: 8px;
    padding: 4px 1.5ch 6px;
    background: #121613;
    border: 1px solid #4a5449;
    border-radius: 6px;
  }
  .progress {
    height: 1.55em;
    background: linear-gradient(#3a413b, #3a413b) 0 50% / 100% 3px no-repeat;
  }
  .progress div {
    height: 1.55em;
    width: 71%;
    background: linear-gradient(#d6f26b, #d6f26b) 0 50% / 100% 3px no-repeat;
  }
  .sel {
    background: #1f261f;
  }
  /* The project counts as running, and the note says so, once the form is saved. */
  :global([data-step='4']) .before-4 {
    display: none;
  }
  :global([data-step]:not([data-step='4'])) .added {
    visibility: hidden;
  }
</style>
