---
import Mark from '../Mark.astro';
import NavMenu from '../NavMenu.svelte';

const links = [
  { href: '/docs/getting-started/install/', label: 'Docs' },
  { href: '#how', label: 'How it works' },
  { href: 'https://github.com/nearhost/nearhost', label: 'GitHub' },
  { href: '#install', label: 'Install' },
];
---

<header class="header">
  <nav class="container nav" aria-label="Main">
    <a href="/" class="brand" aria-label="Nearhost home">
      <Mark size={28} />
      <span class="word">nearhost</span>
    </a>
    <div class="links">
      {links.map((link) =>
        link.label === 'GitHub' ? (
          <a href={link.href} class="github">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2.17c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z" />
            </svg>
            {link.label}
          </a>
        ) : (
          <a href={link.href} class={link.label === 'Install' ? 'button' : undefined}>
            {link.label}
          </a>
        ),
      )}
    </div>
    <div class="menu">
      <NavMenu client:media="(max-width: 719px)" links={links} />
    </div>
  </nav>
</header>

<style>
  .header {
    border-bottom: 1px solid var(--nh-line);
  }
  .nav {
    height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .word {
    font-family: var(--nh-font-display);
    font-weight: 600;
    font-size: 22px;
    letter-spacing: -0.02em;
  }
  .links {
    display: flex;
    align-items: center;
    gap: 28px;
    font-size: 15px;
    font-weight: 500;
  }
  .github {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .button {
    background: var(--nh-accent);
    color: var(--nh-accent-ink);
    padding: 10px 16px;
    border-radius: 8px;
    font-weight: 600;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .button:hover {
    color: var(--nh-accent-ink);
    filter: brightness(1.05);
  }
  .menu {
    display: none;
  }
  @media (max-width: 719px) {
    .links {
      display: none;
    }
    .menu {
      display: block;
    }
  }
</style>
