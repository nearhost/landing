---
// A MacBook running the terminal app with the passthroughs panel open. The screen is drawn at
// 1024×640 and scaled into the 640×400 display. It keeps its own colours in both themes.
---

<div
  class="laptop"
  data-device="laptop"
  role="img"
  aria-label="A MacBook running the Nearhost terminal app. The passthroughs panel lists preflash web and serve-sim, both opened by coding agents from apollo."
>
  <div class="lid">
    <span class="camera" aria-hidden="true"></span>
    <div class="display">
      <div class="screen">
        <div class="bar">
          <span class="light" style="background: #ff5f57"></span>
          <span class="light" style="background: #febc2e"></span>
          <span class="light" style="background: #28c840"></span>
          <span class="title">nearhost</span>
        </div>

        <div class="status">
          <span>
            <span class="brand">nearhost</span> <span class="dim">0.17.0</span>
          </span>
          <span class="dim">
            artemis · <span class="ok">●</span> core running
          </span>
        </div>

        <div class="panes">
          <div class="side">
            <div class="row">
              <span>&#160;home</span>
              <span class="lime">5 running</span>
            </div>
            <div class="gap"></div>
            <div class="row">
              <span>
                &#160;<span class="dim">▾</span> local
              </span>
              <span class="dim">1</span>
            </div>
            <div class="row">
              <span>
                &#160;&#160;&#160;<span class="ok">●</span> website
              </span>
              <span class="dim">running</span>
            </div>
            <div class="row">
              <span>
                &#160;<span class="dim">▾</span> leto
              </span>
              <span>
                <span class="ok">●</span> connected
              </span>
            </div>
            <div class="row">
              <span>
                &#160;&#160;&#160;<span class="ok">●</span> storefront
              </span>
              <span class="dim">running</span>
            </div>
            <div class="row">
              <span>
                &#160;&#160;&#160;<span class="ok">●</span> billing
              </span>
              <span class="dim">running</span>
            </div>
            <div class="row">
              <span>
                &#160;&#160;&#160;<span class="warn">⠹</span> worker
              </span>
              <span class="warn">starting</span>
            </div>
            <div class="row">
              <span>
                &#160;<span class="dim">▾</span> apollo
              </span>
              <span>
                <span class="ok">●</span> connected
              </span>
            </div>
            <div class="row">
              <span>
                &#160;&#160;&#160;<span class="ok">●</span> ios-app
              </span>
              <span class="dim">running</span>
            </div>
            <div class="fill"></div>
            <div class="row selected">
              <span>
                <span class="lime">▌</span>
                <b>passthroughs</b>
              </span>
              <span class="lime">● 2</span>
            </div>
            <div class="row">
              <span>&#160;documents</span>
              <span class="lime">● 1</span>
            </div>
          </div>

          <div class="main">
            <div class="head">
              <b>passthroughs</b>
              <span class="dim">2 open</span>
            </div>
            <div class="gap"></div>
            <div class="entry">
              <span>
                <span class="lime">▌</span>
                <span class="link">http://localhost:7480</span>
              </span>
              <b>preflash web</b>
            </div>
            <div class="dim">
              &#160;&#160;&#160;&#160;from apollo, port 7480 · Claude Code · 12m
            </div>
            <div class="gap"></div>
            <div class="entry">
              <span>
                &#160;<span class="body">http://localhost:3200</span>
              </span>
              <span>serve-sim, iPhone 17</span>
            </div>
            <div class="dim">&#160;&#160;&#160;&#160;from apollo, port 3200 · Codex · 40m</div>
            <div class="fill"></div>
            <div class="docs">
              <span class="dim">documents · newest</span>
              <span>
                &#160;clock-face-plan.md <span class="dim">from leto · Claude Code · 3m</span>
              </span>
            </div>
          </div>
        </div>

        <div class="keys">
          <span>
            <span class="key">↑↓</span> move
          </span>
          <span>
            <span class="key">enter</span> open in browser
          </span>
          <span>
            <span class="key">c</span> copy URL
          </span>
          <span>
            <span class="key">x</span> close
          </span>
          <span>
            <span class="key">?</span> help
          </span>
          <span>
            <span class="key">q</span> quit
          </span>
        </div>
      </div>
    </div>
  </div>
  <div class="base">
    <span class="notch"></span>
  </div>
</div>

<style>
  .laptop {
    position: relative;
    width: 760px;
    height: 438px;
    font-family: var(--nh-font-mono);
    font-variant-ligatures: none;
  }
  .lid {
    position: absolute;
    left: 50px;
    top: 0;
    width: 660px;
    height: 422px;
    box-sizing: border-box;
    padding: 10px;
    border-radius: 18px 18px 4px 4px;
    background: #0a0b0a;
    border: 1px solid #3a3f3b;
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.07),
      0 1px 0 rgba(255, 255, 255, 0.05);
  }
  .camera {
    position: absolute;
    left: 50%;
    top: 3px;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 50%;
    background: #1e2420;
  }
  .display {
    width: 640px;
    height: 400px;
    overflow: hidden;
    border-radius: 6px;
    background: #0b0d0c;
  }
  .screen {
    width: 1024px;
    height: 640px;
    transform: scale(0.625);
    transform-origin: 0 0;
    display: flex;
    flex-direction: column;
    background: #0b0d0c;
    color: #ecefe8;
    font-size: 14px;
    line-height: 21px;
  }
  b {
    font-weight: 600;
  }
  .bar {
    height: 32px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 14px;
    background: #1a1d1b;
    border-bottom: 1px solid #2a312b;
    font-family: var(--nh-font-body);
    font-size: 13px;
    color: #a4ada5;
    flex-shrink: 0;
  }
  .light {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }
  .title {
    flex: 1;
    text-align: center;
    margin-right: 52px;
  }
  .status {
    display: flex;
    justify-content: space-between;
    padding: 10px 18px 6px;
    flex-shrink: 0;
  }
  .brand {
    color: #d6f26b;
    font-weight: 600;
  }
  .dim {
    color: #818a82;
  }
  .ok {
    color: #7fdb8a;
  }
  .warn {
    color: #f2c14e;
  }
  .lime {
    color: #d6f26b;
  }
  .body {
    color: #c5ccc6;
  }
  .panes {
    flex: 1;
    min-height: 0;
    display: flex;
    margin: 0 18px;
    border: 1px solid #2a312b;
    border-radius: 4px;
  }
  .side {
    width: 312px;
    flex-shrink: 0;
    border-right: 1px solid #2a312b;
    padding: 10px 0;
    display: flex;
    flex-direction: column;
  }
  .row {
    display: flex;
    justify-content: space-between;
    padding: 0 14px;
  }
  .selected {
    background: #1d221e;
  }
  .gap {
    height: 21px;
  }
  .fill {
    flex: 1;
  }
  .main {
    flex: 1;
    min-width: 0;
    padding: 10px 18px;
    display: flex;
    flex-direction: column;
  }
  .head {
    display: flex;
    justify-content: space-between;
  }
  .entry {
    display: flex;
    gap: 24px;
  }
  .link {
    color: #d6f26b;
    text-decoration: underline;
  }
  .docs {
    border-top: 1px solid #2a312b;
    padding-top: 10px;
    display: flex;
    flex-direction: column;
  }
  .keys {
    display: flex;
    gap: 22px;
    padding: 8px 18px 10px;
    color: #818a82;
    flex-shrink: 0;
  }
  .key {
    color: #ecefe8;
  }
  .base {
    position: absolute;
    left: 0;
    top: 420px;
    width: 760px;
    height: 18px;
    border-radius: 2px 2px 14px 14px;
    background: linear-gradient(#3a3f3b, #1a1d1b);
    box-shadow: inset 0 1px 0 #4a504b;
    display: flex;
    justify-content: center;
  }
  .notch {
    width: 120px;
    height: 6px;
    border-radius: 0 0 8px 8px;
    background: #121413;
  }
</style>
